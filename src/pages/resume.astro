---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Résumé — Talha Ahmed" description="Résumé of Talha Ahmed, Pipeline & Automation Engineer." wide>
  <div class="section-title" style="flex-wrap: wrap;">
    <h1 class="mt-0">Résumé</h1>
    <div class="resume-tabs" role="tablist" aria-label="Résumé version">
      <button class="resume-tab active" data-resume="/resume/Talha_Ahmed_Resume.pdf" aria-selected="true">Pipeline &amp; Tools</button>
      <button class="resume-tab" data-resume="/resume/Talha_Ahmed_Resume_SoftwareEngineer.pdf" aria-selected="false">Software Engineer</button>
    </div>
  </div>
  <p class="text-soft">Pipeline &amp; Automation Engineer · Technical Artist — 16+ years across animation, VFX, and games. Choose the version that best matches the role.</p>

  <div class="resume-actions">
    <a id="download-resume" class="btn btn-primary" href="/resume/Talha_Ahmed_Resume.pdf" download>Download Résumé</a>
    <a class="btn" href="/resume/Talha_Ahmed_CV_2026.pdf" download>Download Detailed CV</a>
  </div>

  <object id="resume-viewer" class="pdf-frame" data="/resume/Talha_Ahmed_Resume.pdf#view=FitH" type="application/pdf" style="margin-top:1rem">
    <p>Your browser can't display PDFs inline.
      <a id="fallback-resume" href="/resume/Talha_Ahmed_Resume.pdf">Download the résumé instead</a>.</p>
  </object>

  <script is:inline>
    (function () {
      const tabs = document.querySelectorAll('.resume-tab');
      const viewer = document.getElementById('resume-viewer');
      const downloadBtn = document.getElementById('download-resume');
      const fallback = document.getElementById('fallback-resume');

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          const pdf = tab.dataset.resume;
          tabs.forEach(function (t) {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          viewer.setAttribute('data', pdf + '#view=FitH');
          downloadBtn.setAttribute('href', pdf);
          if (fallback) fallback.setAttribute('href', pdf);
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  .resume-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .resume-tab {
    padding: 0.55rem 1rem;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface);
    color: var(--text-soft);
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .resume-tab:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .resume-tab.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .resume-tab.active:hover {
    filter: brightness(1.05);
  }
  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
